# Slim API image — no browser dependencies (~200-300MB)
# Used by: Cloud Run (production), docker-compose backend service (local dev)

FROM node:20-slim AS dashboard-build
WORKDIR /app/dashboard
ARG VITE_API_BASE
ARG VITE_DASHBOARD_BASE=/dashboard/
ARG VITE_AUTH0_DOMAIN
ARG VITE_AUTH0_CLIENT_ID
ARG VITE_AUTH0_AUDIENCE
ARG VITE_AUTH_ORG_CLAIM
ARG VITE_SUPER_ADMIN_EMAILS
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_DASHBOARD_BASE=$VITE_DASHBOARD_BASE
ENV VITE_AUTH0_DOMAIN=$VITE_AUTH0_DOMAIN
ENV VITE_AUTH0_CLIENT_ID=$VITE_AUTH0_CLIENT_ID
ENV VITE_AUTH0_AUDIENCE=$VITE_AUTH0_AUDIENCE
ENV VITE_AUTH_ORG_CLAIM=$VITE_AUTH_ORG_CLAIM
ENV VITE_SUPER_ADMIN_EMAILS=$VITE_SUPER_ADMIN_EMAILS
COPY dashboard/package*.json ./
RUN npm ci
COPY dashboard/ ./
RUN npm run build

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  PIP_NO_CACHE_DIR=1 \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  PLAYWRIGHT_BROWSERS_PATH=/dev/null

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install -r /app/backend/requirements.txt

COPY backend/ ./backend/
COPY --from=dashboard-build /app/dashboard/dist ./dashboard/dist

WORKDIR /app/backend
EXPOSE 8080
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080} --workers ${UVICORN_WORKERS:-4}"]
