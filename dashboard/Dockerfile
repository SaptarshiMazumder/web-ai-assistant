FROM node:20-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_BASE
ARG VITE_DASHBOARD_BASE=/
ARG VITE_AUTH0_DOMAIN
ARG VITE_AUTH0_CLIENT_ID
ARG VITE_AUTH0_AUDIENCE
ARG VITE_AUTH_ORG_CLAIM
ARG VITE_SUPER_ADMIN_EMAILS
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_DASHBOARD_BASE=$VITE_DASHBOARD_BASE
ENV VITE_AUTH0_DOMAIN=$VITE_AUTH0_DOMAIN
ENV VITE_AUTH0_CLIENT_ID=$VITE_AUTH0_CLIENT_ID
ENV VITE_AUTH0_AUDIENCE=$VITE_AUTH0_AUDIENCE
ENV VITE_AUTH_ORG_CLAIM=$VITE_AUTH_ORG_CLAIM
ENV VITE_SUPER_ADMIN_EMAILS=$VITE_SUPER_ADMIN_EMAILS
RUN npm run build

FROM nginx:1.25-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
